{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "io.banbury.desktop",
  "productName": "Banbury",
  "protocols": [
    {
      "name": "Banbury Protocol",
      "schemes": ["banbury"]
    }
  ],
  "directories": {
    "output": "dist-electron-build",
    "buildResources": "electron-app/resources"
  },
  "files": [
    "dist-electron/**/*",
    "!node_modules",
    "!frontend",
    "!backend",
    "!pages",
    "!.next",
    "!stories",
    "!tests"
  ],
  "extraResources": [
    {
      "from": "node_modules/@recallai/desktop-sdk",
      "to": "recall-sdk",
      "filter": ["**/*"]
    }
  ],
  "extraMetadata": {
    "main": "dist-electron/electron-app/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "electron-app/resources/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerIcon": "electron-app/resources/icon.ico",
    "uninstallerIcon": "electron-app/resources/icon.ico",
    "installerHeaderIcon": "electron-app/resources/icon.ico",
    "artifactName": "banbury.setup.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "electron-app/resources/icon.icns",
    "category": "public.app-category.productivity"
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "icon": "electron-app/resources/icons",
    "category": "Office"
  },
  "publish": {
    "provider": "github",
    "releaseType": "release"
  }
}
