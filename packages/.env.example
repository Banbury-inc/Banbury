# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Gemini (composer model list + ChatGoogleGenerativeAI): any one of these is used
GOOGLE_API_KEY=
GEMINI_API_KEY=

# BrowserBase Configuration
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# API Configuration
API_BASE_URL=https://www.api.dev.banbury.io
TAVILY_API_KEY=your_tavily_api_key_here

# Next.js Public Variables (accessible in browser)
NEXT_PUBLIC_JUPYTER_URL=your_jupyter_url_here
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=your_tldraw_license_key_here
# Maps workspace (Mapbox public token pk.*) — required at Docker/CI build time for production
NEXT_PUBLIC_MAPBOX_TOKEN=

# Development/Production Configuration
NODE_ENV=development
